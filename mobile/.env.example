# Local Expo overrides (optional). App falls back to Render URL + secret in lib/env.ts
# EXPO_PUBLIC_API_URL=http://192.168.x.x:4000
# EXPO_PUBLIC_API_SECRET=your-api-secret
EXPO_PUBLIC_API_URL=https://diary-api-2xnl.onrender.com

# Google Drive + Mine Sign in (OAuth Web client from Google Cloud Console)
# 1. https://console.cloud.google.com/ → create/select project
# 2. Enable “Google Drive API”
# 3. APIs & Services → OAuth consent screen (External / Testing is fine)
# 4. Credentials → Create OAuth client ID → Application type: Web application
# 5. Authorized redirect URIs — add EXACTLY (Google rejects diary:// on Web clients):
#      https://diary-api-2xnl.onrender.com/oauth/google/callback
#    If EXPO_PUBLIC_API_URL points elsewhere, use that host + /oauth/google/callback instead.
# 6. Paste the Web client ID below, then restart Expo (npx expo start -c)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional native clients for store / development builds (not used by Expo Go browser OAuth):
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
