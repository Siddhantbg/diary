{
  "expo": {
    "name": "Diary",
    "slug": "personal-memory-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "diary",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Attach photos from your camera to diary days.",
        "NSPhotoLibraryUsageDescription": "Attach photos from your library to diary days.",
        "NSFaceIDUsageDescription": "Unlock your diary with Face ID."
      }
    },
    "android": {
      "package": "com.personal.memorydiary",
      "adaptiveIcon": {
        "backgroundColor": "#F3F6F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Diary to attach photos to your days.",
          "cameraPermission": "Allow Diary to take photos for your days."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3F6F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
