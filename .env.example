# Server
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/diary
API_SECRET=change-me-to-a-long-random-string
PORT=4000
# Gemini — server-only; used for diary write help (fix / continue / suggest)
GEMINI_API_KEY=
# Optional override (default gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Mobile — optional overrides (app falls back to Render URL in lib/env.ts via ||)
# EXPO_PUBLIC_API_URL=http://192.168.x.x:4000
EXPO_PUBLIC_API_URL=https://diary-api-2xnl.onrender.com
EXPO_PUBLIC_API_SECRET=same-as-server-API_SECRET
